# 局域网共享文件夹管理系统 - 环境配置
# Windows 11 部署时复制此文件为 .env 并修改对应值

# 服务器端口
PORT=3002

# JWT 密钥（修改为随机字符串）
JWT_SECRET=your-secret-key-change-this-in-production

# 文件存储根目录（Windows 路径示例）
# 注意：Windows 上使用反斜杠或正斜杠均可，Node.js 兼容两种
FILE_STORAGE_PATH=D:/共享文件

# 可选：设置后可访问 Windows 共享文件夹的 SMB 路径
# SMB_PATH=\\\\192.168.1.100\\共享文件
